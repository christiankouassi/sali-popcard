{
  "name": "sali-popcard-next",
  "version": "2.4.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "admin": "node --env-file=.env.local scripts/admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/run-integration.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:designs": "node tests/designs.mjs",
    "test:smtp": "node tests/run-integration.mjs --smtp",
    "build:dist": "npm run build && node scripts/package-dist.mjs",
    "test:dist": "node tests/run-integration.mjs --standalone",
    "test:journeys": "node tests/e2e-journeys.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "next": "16.4.2",
    "nodemailer": "^10.1.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "^1.64.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "pglite-server": "^0.1.5",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "smtp-server": "^3.19.21",
    "typescript": "^5.9.3"
  }
}
